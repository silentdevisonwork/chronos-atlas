{
  "appId": "com.chronos.atlas",
  "appName": "Chronos Atlas",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#020617",
      "showSpinner": true,
      "spinnerColor": "#fbbf24"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#020617"
    }
  }
}
