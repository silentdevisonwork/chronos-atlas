{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public-safe scholar profile without PII",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "preferredLanguage": { "type": "string", "minLength": 2, "maxLength": 10 },
        "preferredTheme": { "type": "string", "enum": ["dark", "light"] },
        "onboardingCompleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "preferredLanguage", "preferredTheme", "onboardingCompleted", "createdAt", "updatedAt"]
    },
    "UserPrivateAccount": {
      "title": "UserPrivateAccount",
      "description": "Isolated PII document for authenticated user",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 320 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "UserProgressState": {
      "title": "UserProgressState",
      "description": "Persisted exploration progress, favorites, quiz scores, achievements, and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "favoriteCountries": { "type": "array" },
        "favoriteCivilizations": { "type": "array" },
        "favoriteFigures": { "type": "array" },
        "favoritePlanets": { "type": "array" },
        "savedPeriods": { "type": "array" },
        "exploredLocations": { "type": "array" },
        "completedLessons": { "type": "array" },
        "achievements": { "type": "array" },
        "recentSearches": { "type": "array" },
        "quizScores": { "type": "object" },
        "preferences": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "favoriteCountries",
        "favoriteCivilizations",
        "favoriteFigures",
        "favoritePlanets",
        "savedPeriods",
        "exploredLocations",
        "completedLessons",
        "achievements",
        "recentSearches",
        "quizScores",
        "preferences",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Scholar public profile metadata"
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateAccount" },
      "description": "Strictly owner-only PII isolation subcollection"
    },
    "/users/{userId}/progress/{docId}": {
      "schema": { "$ref": "#/entities/UserProgressState" },
      "description": "Owner-only exploration progress, favorites, quizzes, and achievements"
    }
  }
}
